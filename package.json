{
  "name": "discordllm",
  "version": "0.2.0",
  "description": "A Discord bot backed by Claude that works through MCP servers: threads, approvals, schedules, polls.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "discordllm": "./dist/cli.js",
    "discordllm-build": "./dist/build.js"
  },
  "files": [
    "dist",
    "docker",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/cli.js",
    "chat": "node --enable-source-maps dist/cli.js chat",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.226",
    "croner": "^9.1.0",
    "discord.js": "^14.16.3",
    "pino": "^9.5.0",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "pg": "^8.13.0",
    "sharp": "^0.34.5"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-socket": "^0.2.19",
    "@types/node": "^24.13.3",
    "pg": "^8.13.0",
    "pino-pretty": "^13.0.0",
    "sharp": "^0.34.5",
    "typescript": "~5.9.2",
    "vitest": "^4.1.10"
  }
}
